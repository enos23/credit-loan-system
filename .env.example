# Copy to .env (which is gitignored via *.env) and fill in real values.
# All of these are required for `docker compose up` to start the stack.

# JWT signing key. Generate a fresh one per environment:
#   openssl rand -base64 48
JWT_SECRET_KEY=

# PostgreSQL connection string in Npgsql format.
# For Supabase Session pooler (recommended), the format is:
#   Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<ref>;Password=<password>;SslMode=Require;TrustServerCertificate=true
DB_CONNECTION_STRING=

# Anthropic API key for the chatbot feature.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Seed admin user (created only if no Admin exists in the DB yet).
ADMIN_EMAIL=admin@creditapp.com
ADMIN_PASSWORD=

# Frontend public URL — used in email body links (reset password, etc.).
# For local docker-compose, leave the default; for prod, set to the deployed URL.
FRONTEND_URL=http://localhost:5173

# API URL baked into the frontend build. For local docker-compose, leave default;
# for prod, point at the deployed backend.
VITE_API_URL=http://localhost:5286/api
